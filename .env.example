# AI LLM Provider Keys (Optional - Autonomous fallback engine works without any API keys)
# Set at least one if you wish to use live LLM reasoning:
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Default LLM Provider: "groq", "openai", "gemini", or "autonomous" (fallback)
LLM_PROVIDER=autonomous
LLM_MODEL=llama-3.3-70b-versatile

# Investigation Settings
MAX_INVESTIGATION_STEPS=12
MAX_GRAPH_DEPTH=3
